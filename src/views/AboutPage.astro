---
import PageLayout from '../layouts/PageLayout.astro';
import { aboutPortrait, site } from '../config/site';
import { getLocale } from '../i18n/locales';
import { getUI } from '../i18n/ui';
import Icon from '../components/ui/Icon.astro';
import '../styles/catalog.css';

const locale = getLocale(Astro.url);
const text = getUI(locale);
const about = text.about;
---

<PageLayout class="catalog-page" heading={about.title} metaDescription={about.metaDescription}>
  <section class="about-intro" aria-label={about.title}>
    <figure class="portrait" data-placeholder={aboutPortrait ? undefined : ''}>
      {aboutPortrait ? (
        <img src={aboutPortrait} alt={about.portraitAlt} width="256" height="256" loading="eager" decoding="async" />
      ) : (
        <svg class="portrait-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="24" cy="18" r="8" />
          <path d="M8 42c1.5-9 8-14 16-14s14.5 5 16 14" />
        </svg>
      )}
    </figure>
    <div class="about-body">
      {about.story.map((paragraph) => <p set:html={paragraph} />)}
    </div>
    <div class="about-reach">
      <p class="eyebrow">{about.reachLabel}</p>
      <ul class="find-links" aria-label={text.footer.socialsAndContact}>
        {site.socials.map((social) => (
          <li>
            <a href={social.href} rel="me noopener" target="_blank" aria-label={`${social.platform} · ${social.name}`} title={social.platform}>
              <Icon name={social.icon} />
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`} aria-label={`${text.footer.email}: ${site.email}`} title={site.email}>
            <Icon name="email" />
          </a>
        </li>
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .about-intro { container-type: inline-size; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); grid-template-areas: 'portrait body' 'portrait reach'; grid-template-rows: auto 1fr; column-gap: clamp(32px, 5vw, 72px); align-items: start; }

  .portrait { grid-area: portrait; align-self: stretch; min-height: 20rem; max-height: 47cqw; position: relative; display: grid; place-items: center; width: 100%; margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-card); background: var(--surface); }
  .portrait > * { grid-area: 1 / 1; }
  .portrait img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 0; image-rendering: pixelated; }
  .portrait[data-placeholder] { color: var(--muted); background: linear-gradient(160deg, var(--surface-elevated), var(--surface)); }
  .portrait-icon { width: clamp(56px, 24%, 96px); height: auto; opacity: 0.5; }

  .about-body { grid-area: body; }
  .about-body p { margin: 0 0 1.1em; color: var(--text); font-size: 1.05rem; line-height: 1.75; text-align: justify; text-justify: inter-word; }
  .about-body p:last-child { margin-bottom: 0; }
  .about-body :global(:is(strong, b)) { color: var(--accent); font-weight: 600; }

  .about-reach { grid-area: reach; align-self: end; padding-top: 36px; }
  .about-reach .eyebrow { margin: 0 0 14px; }
  .find-links { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; padding: 0; list-style: none; }
  .find-links a { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--control-line); border-radius: var(--radius-pill); color: var(--text); }
  .find-links a:hover { border-color: var(--accent); color: var(--accent-ink); background: var(--accent); }
  .find-links :global(svg) { width: 20px; height: 20px; fill: currentColor; }

  @media (max-width: 900px) {
    .about-intro { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; grid-template-areas: 'portrait' 'body' 'reach'; row-gap: 0; }
    .portrait { align-self: start; aspect-ratio: 4 / 5; min-height: 0; max-height: none; max-width: 420px; margin-bottom: 32px; }
    .about-body { margin-bottom: 32px; }
    .about-reach { padding-top: 0; }
  }
</style>
