---
import Cta from '../ui/Cta.astro';
import Disciplines from './Disciplines.astro';
import { getLocale, localizedUrl } from '../../i18n/locales';
import { getUI } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const text = getUI(locale);
---

<section class="creator-section wrap" aria-labelledby="creator-title">
  <div class="creator-intro">
    <h2 id="creator-title" class="eyebrow">{text.home.introductionLabel}</h2>
    <div class="creator-copy">
      <p class="creator-statement" set:html={text.home.introduction} />
      <div class="creator-more"><Cta href={localizedUrl(locale, '/about/')} tone="outline" variant="wipe">{text.home.readMore}</Cta></div>
    </div>
  </div>
  <Disciplines />
</section>

<style>
  .creator-section { padding-block: clamp(72px, 9vw, 128px) 0; }
  .creator-intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 24px 48px; }
  .creator-intro .eyebrow { margin: 12px 0 0; }
  .creator-statement :global(:is(strong, b)) { color: var(--accent); font-weight: 600; }
  .creator-statement { margin: 0; font-size: clamp(1.6rem, 3.1vw, 2.8rem); font-family: var(--serif); font-weight: 400; line-height: 1.18; letter-spacing: var(--heading-tracking); text-wrap: pretty; }
  .creator-more { margin-top: 32px; }
  @media (max-width: 640px) {
    .creator-intro { grid-template-columns: minmax(0, 1fr); }
    .creator-intro .eyebrow { margin-top: 0; }
  }
</style>
