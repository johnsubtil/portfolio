---
import HeroScene from '../motion/HeroScene';
import FeaturedHero from './FeaturedHero.astro';
import { homeFeaturedLimit } from '../../config/content';
import { getLocale, localizedUrl } from '../../i18n/locales';
import { getProjects } from '../../lib/content/queries';
import { getUI } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const text = getUI(locale);
const featured = (await getProjects(locale))
  .filter((project) => project.data.featured)
  .slice(0, homeFeaturedLimit);
---

{featured.length > 0 ? (
  <FeaturedHero projects={featured} />
) : (
  <HeroScene client:load copy={{
    lineOne: text.home.heroLineOne,
    lineTwo: text.home.heroLineTwo,
    description: text.home.heroDescription,
    primary: { label: text.home.heroPrimary, href: localizedUrl(locale, '/projects/') },
    secondary: { label: text.home.heroSecondary, href: '#social' },
  }} />
)}
<div class="hero-fade" aria-hidden="true"></div>

<style>
  .hero-fade {
    position: relative;
    z-index: 2;
    height: 0;
    pointer-events: none;
  }

  .hero-fade::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: clamp(96px, 16vw, 200px);
    background: linear-gradient(
      to bottom,
      var(--background) 0%,
      color-mix(in srgb, var(--background) 88%, transparent) 12%,
      color-mix(in srgb, var(--background) 62%, transparent) 28%,
      color-mix(in srgb, var(--background) 34%, transparent) 46%,
      color-mix(in srgb, var(--background) 12%, transparent) 66%,
      transparent 88%
    );
  }
</style>
