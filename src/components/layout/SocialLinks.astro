---
import { site } from '../../config/site';
import { getLocale } from '../../i18n/locales';
import { getUI } from '../../i18n/ui';
import Icon from '../ui/Icon.astro';

interface Props { includeEmail?: boolean; }
const { includeEmail = false } = Astro.props;

const text = getUI(getLocale(Astro.url));
---

<!-- Icons: Font Awesome Free by Fonticons, Inc. https://fontawesome.com | CC BY 4.0 https://creativecommons.org/licenses/by/4.0/ -->
<ul class="social-links" aria-label={includeEmail ? text.footer.socialsAndContact : text.footer.socials}>
  {site.socials.map((social) => {
    const label = `${social.platform} · ${social.name}`;

    return (
      <li>
        <a class="social-link" href={social.href} aria-label={label} title={label}>
          <Icon name={social.icon} />
        </a>
      </li>
    );
  })}
  {includeEmail && <li>
    <a class="social-link" href={`mailto:${site.email}`} aria-label={`${text.footer.email}: ${site.email}`} title={site.email}>
      <Icon name="email" />
    </a>
  </li>}
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: nowrap;
    justify-content: flex-start;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 100%;
  }

  .social-links li { flex: 0 1 44px; min-width: 0; }

  .social-link {
    display: grid;
    place-items: center;
    width: 44px;
    max-width: 100%;
    height: 44px;
    color: var(--muted);
  }

  a:hover {
    color: var(--accent);
  }

  a:focus-visible {
    outline-color: var(--accent);
  }

  .social-link :global(svg) {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
</style>
